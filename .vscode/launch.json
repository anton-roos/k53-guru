{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Launch K53Guru.Server.UI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/src/K53Guru/src/Server.UI/bin/Debug/net10.0/K53Guru.Server.UI.dll",
      "cwd": "${workspaceFolder}/src/K53Guru/src/Server.UI",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7256;http://localhost:5056"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": ".NET: Attach to K53Guru.Server.UI",
      "type": "coreclr",
      "request": "attach",
      "processName": "K53Guru.Server.UI"
    },
  ],
}
