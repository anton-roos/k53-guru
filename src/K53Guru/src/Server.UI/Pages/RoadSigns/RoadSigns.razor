@page "/system/roadsigns"
@using K53Guru.Application.Features.RoadSigns.DTOs
@using K53Guru.Application.Features.RoadSigns.Queries.Pagination
@using K53Guru.Application.Features.RoadSigns.Queries.GetById
@using K53Guru.Application.Features.RoadSigns.Caching
@using K53Guru.Server.UI.Pages.RoadSigns.Components

@attribute [Authorize(Policy = Permissions.RoadSigns.View)]
@inject IStringLocalizer<RoadSigns> L

<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             T="RoadSignDto"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             Hover="true" @ref="_roadSignsGrid">
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Traffic" Size="Size.Large" />
                <MudText Typo="Typo.subtitle2">@L[_currentDto.GetClassDescription()]</MudText>
            </MudStack>
            <MudStack Spacing="2" AlignItems="AlignItems.End">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                </MudStack>
                <MudTextField T="string"
                               ValueChanged="@(s => OnSearch(s))"
                               Value="@_roadSignsQuery.Keyword"
                               Placeholder="@AppStrings.Search"
                               Adornment="Adornment.End"
                               AdornmentIcon="@Icons.Material.Filled.Search"
                               IconSize="Size.Small">
                </MudTextField>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                <MudTooltip Text="@L["View details"]" Delay="300">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   OnClick="@(() => OnViewRoadSign(context.Item))">
                    </MudIconButton>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L[_currentDto.GetMemberDescription(x => x.ImageAssetKey)]" Sortable="false">
            <CellTemplate>
                @{
                    var imageUrl = GetImageUrl(context.Item.ImageAssetKey);
                }
                @if (imageUrl is not null)
                {
                    <MudImage Src="@imageUrl"
                              Width="50"
                              Height="50"
                              ObjectFit="ObjectFit.ScaleDown"
                              Class="rounded-lg">
                    </MudImage>
                }
                else
                {
                    <MudPaper Outlined="true"
                              Class="d-flex align-center justify-center rounded-lg"
                              Style="width:50px;height:50px;">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Default" />
                    </MudPaper>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LegislationCode" Title="@L[_currentDto.GetMemberDescription(x => x.LegislationCode)]" />
        <PropertyColumn Property="x => x.Description" Title="@L[_currentDto.GetMemberDescription(x => x.Description)]" />
    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new[] { 10, 15, 30, 50, 100 })" />
    </PagerContent>
</MudDataGrid>

@code {
    public string? Title { get; private set; }
    private MudDataGrid<RoadSignDto> _roadSignsGrid = default!;
    private readonly RoadSignDto _currentDto = new();
    private bool _loading;
    private int _defaultPageSize = 15;

    private RoadSignsWithPaginationQuery _roadSignsQuery { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title = $"{ApplicationSettings.AppName} - {L[_currentDto.GetClassDescription()]}";
        await Task.CompletedTask;
    }

    private async Task<GridData<RoadSignDto>> ServerReload(GridState<RoadSignDto> state)
    {
        try
        {
            _loading = true;
            _roadSignsQuery.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            _roadSignsQuery.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                                ? SortDirection.Descending.ToString()
                                                : SortDirection.Ascending.ToString();
            _roadSignsQuery.PageNumber = state.Page + 1;
            _roadSignsQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_roadSignsQuery).ConfigureAwait(false);
            return new GridData<RoadSignDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string text)
    {
        _roadSignsQuery.Keyword = text;
        await _roadSignsGrid.ReloadServerData();
    }

    private async Task OnRefresh()
    {
        RoadSignCacheKey.Refresh();
        _roadSignsQuery.Keyword = string.Empty;
        await _roadSignsGrid.ReloadServerData();
    }

    private static string? GetImageUrl(string? imageAssetKey)
    {
        if (string.IsNullOrWhiteSpace(imageAssetKey))
            return null;

        var escapedSegments = imageAssetKey.Split('/').Select(Uri.EscapeDataString);
        return $"/img/{string.Join('/', escapedSegments)}";
    }

    private async Task OnViewRoadSign(RoadSignDto dto)
    {
        var result = await Mediator.Send(new GetRoadSignByIdQuery { Id = dto.Id });
        result.Match(data =>
        {
            var parameters = new DialogParameters<RoadSignDetailDialog>
            {
                { x => x.Model, data }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
            _ = DialogService.ShowAsync<RoadSignDetailDialog>(L["Road Sign"], parameters, options);
        }, errors =>
        {
            Snackbar.Add(errors, Severity.Error);
        });
    }
}
