@page "/system/tests"
@using K53Guru.Application.Features.Tests.DTOs
@using K53Guru.Application.Features.Tests.Queries.Pagination
@using K53Guru.Application.Features.Tests.Queries.GetById
@using K53Guru.Application.Features.Tests.Caching
@using K53Guru.Application.Features.Tests.Commands.AddEdit
@using K53Guru.Application.Features.Tests.Commands.Publish
@using K53Guru.Application.Features.Tests.Commands.Unpublish
@using K53Guru.Domain.Enums
@using K53Guru.Server.UI.Pages.Tests.Components

@attribute [Authorize(Policy = Permissions.Tests.View)]
@inject IStringLocalizer<Tests> L

<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             T="TestDto"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             Hover="true" @ref="_testsGrid">
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Size="Size.Large" />
                <MudText Typo="Typo.subtitle2">@L[_currentDto.GetClassDescription()]</MudText>
            </MudStack>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                <MudButton Disabled="@_loading"
                           OnClick="@(() => OnRefresh())"
                           StartIcon="@Icons.Material.Outlined.Refresh">
                    @AppStrings.Refresh
                </MudButton>
                @if (_accessRights.Create)
                {
                    <MudButton StartIcon="@Icons.Material.Outlined.Add"
                               OnClick="OnCreateTest">
                        @AppStrings.New
                    </MudButton>
                }
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Edit)
                {
                    <MudTooltip Text="@AppStrings.Edit" Delay="300">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => OnEditTest(context.Item))">
                        </MudIconButton>
                    </MudTooltip>
                }
                @if (_accessRights.Publish)
                {
                    @if (context.Item.Status == TestStatus.Draft)
                    {
                        <MudTooltip Text="@L["Publish"]" Delay="300">
                            <MudIconButton Icon="@Icons.Material.Filled.Publish"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           Disabled="@_actionInProgress"
                                           OnClick="@(() => OnPublishTest(context.Item))">
                            </MudIconButton>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@L["Unpublish"]" Delay="300">
                            <MudIconButton Icon="@Icons.Material.Filled.Unpublished"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           Disabled="@_actionInProgress"
                                           OnClick="@(() => OnUnpublishTest(context.Item))">
                            </MudIconButton>
                        </MudTooltip>
                    }
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="@L[_currentDto.GetMemberDescription(x => x.Name)]" />
        <PropertyColumn Property="x => x.Codes" Title="@L[_currentDto.GetMemberDescription(x => x.Codes)]" />
        <PropertyColumn Property="x => x.Sections" Title="@L[_currentDto.GetMemberDescription(x => x.Sections)]" />
        <PropertyColumn Property="x => x.Status" Title="@L[_currentDto.GetMemberDescription(x => x.Status)]" />
        <TemplateColumn Title="@L["Questions"]" Sortable="false">
            <CellTemplate>
                @context.Item.Questions.Count
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new[] { 10, 15, 30, 50, 100 })" />
    </PagerContent>
</MudDataGrid>

@code {
    public string? Title { get; private set; }
    private MudDataGrid<TestDto> _testsGrid = default!;
    private readonly TestDto _currentDto = new();
    private TestsAccessRights _accessRights = new();
    private bool _loading;
    private bool _actionInProgress;
    private int _defaultPageSize = 15;

    private TestsWithPaginationQuery _testsQuery { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title = $"{ApplicationSettings.AppName} - {L[_currentDto.GetClassDescription()]}";
        _accessRights = await PermissionService.GetAccessRightsAsync<TestsAccessRights>();
    }

    private async Task<GridData<TestDto>> ServerReload(GridState<TestDto> state)
    {
        try
        {
            _loading = true;
            _testsQuery.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            _testsQuery.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                                ? SortDirection.Descending.ToString()
                                                : SortDirection.Ascending.ToString();
            _testsQuery.PageNumber = state.Page + 1;
            _testsQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_testsQuery).ConfigureAwait(false);
            return new GridData<TestDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRefresh()
    {
        TestCacheKey.Refresh();
        await _testsGrid.ReloadServerData();
    }

    private async Task ShowTestFormDialog(string title, AddEditTestCommand command)
    {
        var parameters = new DialogParameters<TestFormDialog>
        {
            { x => x._model, command }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TestFormDialog>(title, parameters, options);
        var state = await dialog.Result;
        if (state is not null && !state.Canceled)
        {
            await _testsGrid.ReloadServerData();
        }
    }

    private async Task OnCreateTest()
    {
        var command = new AddEditTestCommand();
        await ShowTestFormDialog(L["New test"], command);
    }

    private async Task OnEditTest(TestDto dto)
    {
        var result = await Mediator.Send(new GetTestByIdQuery { Id = dto.Id });
        await result.MatchAsync(async data =>
        {
            var command = Mapper.Map<AddEditTestCommand>(data);
            await ShowTestFormDialog(L["Edit the test"], command);
        }, errors =>
        {
            Snackbar.Add(errors, Severity.Error);
            return Task.CompletedTask;
        });
    }

    private async Task OnPublishTest(TestDto dto)
    {
        try
        {
            _actionInProgress = true;
            var result = await Mediator.Send(new PublishTestCommand { Id = dto.Id });
            await result.MatchAsync(async () =>
            {
                Snackbar.Add(L["Test published successfully"], Severity.Info);
                await _testsGrid.ReloadServerData();
            }, errors =>
            {
                Snackbar.Add(errors, Severity.Error);
                return Task.CompletedTask;
            });
        }
        finally
        {
            _actionInProgress = false;
        }
    }

    private async Task OnUnpublishTest(TestDto dto)
    {
        try
        {
            _actionInProgress = true;
            var result = await Mediator.Send(new UnpublishTestCommand { Id = dto.Id });
            await result.MatchAsync(async () =>
            {
                Snackbar.Add(L["Test unpublished successfully"], Severity.Info);
                await _testsGrid.ReloadServerData();
            }, errors =>
            {
                Snackbar.Add(errors, Severity.Error);
                return Task.CompletedTask;
            });
        }
        finally
        {
            _actionInProgress = false;
        }
    }
}
